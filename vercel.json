{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "cd frontend-vite && npm install && npm run build",
    "outputDirectory": "frontend-vite/dist",
    "framework": "vite",
    "installCommand": "cd frontend-vite && npm install",
    "env": {
        "VITE_API_URL": "https://sliceinsights-4rmf.onrender.com/api/v1"
    },
    "rewrites": [
        { "source": "/paddles", "destination": "https://sliceinsights-4rmf.onrender.com/api/v1/paddles" }
    ]
}
