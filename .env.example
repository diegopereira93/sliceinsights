# ============================================
# REQUIRED: Database Configuration
# ============================================
# ⚠️ IMPORTANT: Change these values in production!
# Get Supavisor pooler string from: Supabase Dashboard → Settings → Database → Connection string → Supavisor (transaction mode, port 6543)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres

# CORS - Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8002

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1

# ============================================
# Observability (Optional)
# ============================================
SENTRY_DSN=  # Add your Sentry DSN for error tracking

# ============================================
# LLM Engine
# ============================================
GROQ_API_KEY= # Obtain at https://console.groq.com/

# ============================================
# Affiliate Program (Monetization)
# ============================================
AFFILIATE_AMAZON_TAG=  # Amazon Associates tag (e.g., sliceinsights-20)
AFFILIATE_ML_ID=       # Mercado Livre affiliate ID

# ============================================
# Price Alerts (Optional)
# ============================================
PRICE_ALERT_WEBHOOK_URL=  # Discord/Slack webhook for notifications
TELEGRAM_BOT_TOKEN=       # Telegram bot token (from @BotFather)
TELEGRAM_CHAT_ID=         # Telegram chat ID for notifications

