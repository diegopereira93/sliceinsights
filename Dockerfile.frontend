# ============================================
# Frontend Dockerfile - Vite + nginx Multi-stage Build
# ============================================

# Stage 1: Build the Vite SPA
FROM node:20-alpine AS builder
WORKDIR /app

# Copy package files
COPY frontend-vite/package.json frontend-vite/package-lock.json* ./
RUN npm ci

# Copy the rest of the frontend
COPY frontend-vite/ .

# Build-time ARG for API URL (Vite embeds env vars at build time via import.meta.env)
ARG VITE_API_URL=http://localhost:8002
ENV VITE_API_URL=${VITE_API_URL}

# Build the Vite SPA
RUN npm run build

# ============================================
# Stage 2: Serve with nginx
FROM nginx:alpine AS runner

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config for SPA fallback
COPY frontend-vite/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
